DirectoryIndex disabled

# Passenger / cPanel Node.js Selector: Route all HTTP and WebSocket requests to the Node.js app
RewriteEngine On

# WebSocket proxy (critical for Socket.io)
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule /(.*) ws://127.0.0.1:3000/$1 [P,L]

# Regular HTTP proxy — all requests forwarded to Node.js
RewriteCond %{HTTP:Upgrade} !=websocket [NC]
RewriteRule /(.*) http://127.0.0.1:3000/$1 [P,L]
